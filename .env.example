# Copy to .env.local and adjust. All values are optional.

# Upstream ACE open-data API (server-side only).
ACE_API_BASE_URL=https://ace-api.duckdns.org

# Typical household electricity use, kWh/year, for "homes powered".
# Default 2500 = Ofgem Typical Domestic Consumption Value from 1 July 2026.
NEXT_PUBLIC_HOUSEHOLD_KWH_PER_YEAR=2500

# Community fund per kWh generated (GBP), e.g. 0.012. Leave empty until ACE
# publishes the real figure: the kiosk then shows lifetime energy instead.
NEXT_PUBLIC_COMMUNITY_FUND_GBP_PER_KWH=
